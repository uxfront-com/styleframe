{
	"name": "@styleframe/docs",
	"type": "module",
	"version": "2.0.1",
	"scripts": {
		"build": "nuxt generate",
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"typecheck": "nuxt prepare && vue-tsc -b --noEmit --pretty false 2>&1 | awk '/^[^ ]/ { own = !/node_modules\\/(.*\\/)?docus\\// } own { print; failed = 1 } END { exit failed }'",
		"test": "vitest run",
		"test:build": "vitest run --config vitest.build.config.ts",
		"postinstall": "nuxt prepare"
	},
	"dependencies": {
		"@nuxt/content": "catalog:docs",
		"@uxfront/layer-docs": "catalog:docs",
		"@uxfront/layer-ui": "catalog:docs",
		"@uxfront/scene": "catalog:docs",
		"@uxfront/ui": "catalog:docs",
		"@vueuse/core": "catalog:docs",
		"defu": "catalog:",
		"docus": "catalog:docs",
		"nuxt": "catalog:docs",
		"posthog-js": "catalog:nuxt",
		"vue": "catalog:nuxt",
		"vue-router": "catalog:docs",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@iconify-json/devicon": "catalog:nuxt",
		"@iconify-json/lucide": "catalog:docs",
		"@iconify-json/mdi": "catalog:nuxt",
		"@iconify-json/simple-icons": "catalog:docs",
		"@iconify-json/vscode-icons": "catalog:docs",
		"@nuxt/kit": "catalog:docs",
		"typescript": "catalog:nuxt",
		"vitest": "catalog:",
		"vue-tsc": "catalog:nuxt"
	},
	"files": [
		"LICENSE",
		"app"
	]
}
