{
	"$schema": "https://turbo.build/schema.json",
	"globalEnv": ["SUPABASE_*", "NUXT_*"],
	"tasks": {
		"build": {
			"cache": true,
			"inputs": [
				"src/**",
				"content/**",
				"vite.config.ts",
				"tsdown.config.ts",
				"package.json"
			],
			"outputs": [
				"theme/**",
				"dist/**",
				".output/**",
				".nuxt/**",
				"storybook-static/**"
			],
			"dependsOn": ["^build"]
		},
		"@styleframe/docs#build": {
			"cache": true,
			"env": ["NITRO_PRESET"],
			"inputs": [
				"app/**",
				"server/**",
				"public/**",
				"modules/**",
				"content/**",
				"nuxt.config.ts",
				"app.config.ts",
				"content.config.ts",
				"package.json"
			],
			"outputs": [".output/**", ".nuxt/**", ".vercel/output/**"],
			"dependsOn": ["^build"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"test": {
			"dependsOn": ["^test"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"storybook": {
			"cache": false,
			"persistent": true
		},
		"clean": {
			"cache": false
		},
		"start": {
			"cache": false,
			"persistent": false
		}
	}
}
